load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//092_stamped_release:release.bzl", "release_manifest")

release_manifest(
    name = "manifest",
    app_name = "demo-service",
)

# A release bundle that carries its own provenance: what it is, and which
# source commit produced it.
pkg_tar(
    name = "release",
    srcs = [
        ":manifest",
        "//172_os_packages:demo_service_deb",
    ],
    extension = "tar.gz",
    package_dir = "/release",
)
