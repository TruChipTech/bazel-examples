load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

# bzl_library declares .bzl files as a dependency unit so other packages can
# depend on them for documentation generation and Starlark-level testing.
bzl_library(
    name = "constants",
    srcs = ["constants.bzl"],
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "rules",
    srcs = ["rules.bzl"],
    visibility = ["//visibility:public"],
    deps = [":constants"],
)
