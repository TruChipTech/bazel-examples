load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

package(default_visibility = ["//visibility:public"])

# pkg_tar is deterministic by construction: entries are sorted, mtimes are
# pinned to a fixed epoch, and uid/gid are zeroed. Build it twice and the
# digest is identical.
pkg_tar(
    name = "layer",
    srcs = [
        "app.txt",
        "lib.txt",
    ],
    mode = "0644",
    package_dir = "/opt/app",
)

# Prove it: the digest is recorded as a build artifact.
genrule(
    name = "layer_digest",
    srcs = [":layer"],
    outs = ["layer.sha256"],
    cmd = "sha256sum $(location :layer) | cut -d' ' -f1 > $@",
)

# A hand-rolled tar that is NOT deterministic, for contrast. Tagged manual so
# it never runs in a normal build - its output changes every time.
genrule(
    name = "nondeterministic_layer",
    srcs = [
        "app.txt",
        "lib.txt",
    ],
    outs = ["bad_layer.tar"],
    cmd = "tar cf $@ $(SRCS)",
    tags = ["manual"],
)
