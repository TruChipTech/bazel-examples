load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//200_capstone_production/rules:defs.bzl", "generated_config")

package(default_visibility = ["//200_capstone_production:__subpackages__"])

# The config header is generated by our custom rule, driven by a build setting.
generated_config(
    name = "capstone_config",
    entries = {"service": "telemetry-collector"},
)

# Wrapping the generated header in a cc_library gives it an include path.
cc_library(
    name = "config",
    hdrs = [":capstone_config"],
    includes = ["."],
)

cc_binary(
    name = "collector",
    srcs = ["collector.cc"],
    deps = [
        ":config",
        "//200_capstone_production/schema:telemetry_cc_proto",
    ],
)
