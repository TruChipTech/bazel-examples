load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_python//python:defs.bzl", "py_binary")
load(":oci.bzl", "oci_image")

package(default_visibility = ["//visibility:public"])

# A layer is just a tarball of a filesystem tree. Determinism matters: mtimes,
# ownership and entry order all end up in the layer's digest.
pkg_tar(
    name = "app_layer",
    srcs = ["app.sh"],
    mode = "0755",
    package_dir = "/app",
)

py_binary(
    name = "mkoci",
    srcs = ["mkoci.py"],
    main = "mkoci.py",
)

# A genrule CANNOT declare a directory output:
#   "output ... is a directory but was not declared as such"
# So the image is built by a rule using ctx.actions.declare_directory.
oci_image(
    name = "image",
    entrypoint = "/app/app.sh",
    layers = [":app_layer"],
    ref = "demo:v1",
)
