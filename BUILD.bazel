# Root package.
#
# The examples live in a flat tree (001_ upward), so there is no grouping
# directory to point `bazel test` at. These suites restore that:
#
#   bazel test //:foundations  examples 001-050  - targets, deps, tests, visibility
#   bazel test //:composition  examples 051-100  - macros, select(), external deps
#   bazel test //:authoring    examples 101-150  - writing rules, aspects, toolchains
#   bazel test //:operations   examples 151-200  - caching, hermeticity, CI
#   bazel test //:images       examples 201-250  - OCI images from first principles
#   bazel test //:signing      examples 251-300  - signatures, attestation, supply chain
#   bazel test //:firmware     examples 301-350  - bare metal, flash images, secure boot
#   bazel test //:parallel     examples 401-450  - fan-out and multi-arch matrices
#   bazel test //:all_tests   everything
#
# Plain wildcards still work: bazel build //...  /  bazel test //...
#
# NOTE: tests tagged "manual" are excluded - some examples ship a test that
# is MEANT to fail, to show what the failure looks like.

