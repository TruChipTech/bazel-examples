# genrule runs an arbitrary shell command as a build step. It is the escape
# hatch for "I just need to run this command" before you invest in a real rule.

genrule(
    name = "greetings",
    srcs = ["names.txt"],
    outs = ["greetings.txt"],

    # Inside cmd, Bazel expands these "Make variables":
    #   $(SRCS)  - all srcs, space separated
    #   $(OUTS)  - all outs
    #   $<       - the single src   (only valid when there is exactly one)
    #   $@       - the single out   (only valid when there is exactly one)
    # Note: $$ escapes a literal $ for the shell, because Bazel consumes one.
    cmd = "sed 's/^/hello, /' $< > $@",
)

# A genrule with no inputs at all - useful for generated constants.
genrule(
    name = "build_info",
    outs = ["build_info.txt"],
    cmd = "echo 'generated by a genrule' > $@ && echo 'no inputs required' >> $@",
)
