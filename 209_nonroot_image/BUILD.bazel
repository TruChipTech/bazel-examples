load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

package(default_visibility = ["//visibility:public"])

# Ownership is baked into the LAYER, not decided at runtime. pkg_files is the
# only way to control uid/gid and mode precisely (sample 086).
pkg_files(
    name = "app_files",
    srcs = ["app.sh"],
    attributes = pkg_attributes(
        group = "nonroot",
        mode = "0550",
        owner = "65532.65532",
        user = "nonroot",
    ),
    prefix = "/app",
)

pkg_tar(
    name = "layer",
    srcs = [":app_files"],
)
